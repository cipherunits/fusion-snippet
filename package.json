{
  "name": "fusion-snippet",
  "displayName": "Fusion Snippet",
  "description": "Code snippets for Fusion Framework developers — TypeScript, Python, and C#.",
  "version": "1.0.2",
  "publisher": "cipherunits",
  "author": {
    "name": "Cipher Unit",
    "email": "cipherunit.dev@gmail.com",
    "url": "https://cipherunit.xyz"
  },
  "license": "MIT",
  "pricing": "Free",
  "icon": "assets/fusion-logo.png",
  "galleryBanner": {
    "color": "#0B1220",
    "theme": "dark"
  },
  "homepage": "https://fusion.cipherunit.xyz",
  "repository": {
    "type": "git",
    "url": "https://github.com/cipherunits/fusion-snippet.git"
  },
  "bugs": {
    "url": "https://github.com/cipherunits/fusion-snippet/issues"
  },
  "qna": "https://github.com/cipherunits/fusion-snippet/issues",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Snippets"
  ],
  "keywords": [
    "snippets",
    "fusion",
    "fusion-framework",
    "typescript",
    "python",
    "csharp",
    "c#",
    "productivity",
    "boilerplate"
  ],
  "contributes": {
    "snippets": [
      {
        "language": "typescript",
        "path": "./snippets/typescript/snippets.json"
      },
      {
        "language": "python",
        "path": "./snippets/python/snippets.json"
      },
      {
        "language": "csharp",
        "path": "./snippets/csharp/snippets.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "pnpm run check-types && pnpm run lint",
    "compile": "pnpm run check-types && pnpm run lint && node esbuild.js",
    "package": "pnpm run check-types && pnpm run lint && node esbuild.js --production",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "pnpm run compile-tests && pnpm run compile && pnpm run lint",
    "test": "vscode-test",
    "prepare": "husky",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "precommit": "pnpm check-types && pnpm lint && pnpm format",
    "vsix": "vsce package --no-dependencies",
    "publish:vsce": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
